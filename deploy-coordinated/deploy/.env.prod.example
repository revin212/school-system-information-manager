# Copy ke deploy/.env.prod (lihat README deploy VPS).
# Network dan host menyatu dengan stack postgres-portfolio.

SHARED_DOCKER_NETWORK=postgres-portfolio-net

DATABASE_URL=postgres://simsekolah_user:ganti_password_kuat@postgres-portfolio:5432/simsekolah

BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Frontend dan API dipisah subdomain:
# - Frontend: https://sim.revindennis.cloud
# - API: https://sim-api.revindennis.cloud (proxy ke 127.0.0.1:4005)
BETTER_AUTH_URL=https://sim.revindennis.cloud
CORS_ORIGIN=https://sim.revindennis.cloud

# Bind API loopback (untuk Nginx host proxy)
API_PORT=4005
API_INTERNAL_PORT=8000
