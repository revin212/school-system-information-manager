# Alamat situs untuk Caddy (HTTPS otomatis untuk hostname biasa; pakai http:// untuk lokal).
SITE_ADDRESS=sim.revindennis.cloud

# Network Docker bersama (harus sudah dibuat: docker network create ...).
# Container Postgres bersama dan stack aplikasi ini harus di network yang sama.
SHARED_DOCKER_NETWORK=postgres-portfolio-net

# Referensi provisioning (compose prod memakai DATABASE_URL).
POSTGRES_USER=simsekolah_user
POSTGRES_PASSWORD=ganti_password_kuat
POSTGRES_DB=simsekolah

# URL koneksi dari container API ke Postgres bersama (host = container postgres-portfolio).
DATABASE_URL=postgres://simsekolah_user:ganti_password_kuat@postgres-portfolio:5432/simsekolah

# Better Auth
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://sim.revindennis.cloud

# CORS (set ke origin website)
CORS_ORIGIN=https://sim.revindennis.cloud

# Frontend build-time env (origin yang sama dengan browser / cookie session)
VITE_API_BASE_URL=https://sim-api.revindennis.cloud
