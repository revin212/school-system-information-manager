# Copy ke deploy/.env.prod di VPS.
# School SIM (portfolio coordinated): frontend + API beda subdomain.

SHARED_DOCKER_NETWORK=postgres-portfolio-net

# Referensi provisioning DB (jangan commit password asli).
POSTGRES_USER=simsekolah_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=simsekolah

# Host wajib nama container postgres bersama pada network di atas.
DATABASE_URL=postgres://simsekolah_user:CHANGE_ME_DB_PASSWORD@postgres-portfolio:5432/simsekolah

BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://sim.revindennis.cloud
CORS_ORIGIN=https://sim.revindennis.cloud
VITE_API_BASE_URL=https://sim-api.revindennis.cloud

# API bind ke loopback host; expose publik lewat Nginx + TLS.
API_PORT=4005
API_INTERNAL_PORT=8000
