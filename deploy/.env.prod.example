# Alamat situs untuk Caddy (HTTPS otomatis untuk hostname biasa; pakai http:// untuk lokal).
SITE_ADDRESS=sim.example.com

# Network Docker bersama (harus sudah dibuat: docker network create ...).
# Container Postgres bersama dan stack aplikasi ini harus di network yang sama.
SHARED_DOCKER_NETWORK=shared_db

# Referensi saat membuat user/database di Postgres bersama (tidak dipakai compose prod tanpa layanan postgres).
POSTGRES_USER=simsekolah
POSTGRES_PASSWORD=ganti_password_kuat
POSTGRES_DB=simsekolah

# URL koneksi dari container API ke Postgres BERSAMA.
# Host = nama container atau alias Postgres di SHARED_DOCKER_NETWORK (bukan service "postgres" compose lokal kecuali namanya memang sama).
DATABASE_URL=postgres://simsekolah:ganti_password_kuat@nama_container_postgres_bersama:5432/simsekolah

# Better Auth
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://sim.example.com

# CORS (set ke origin website)
CORS_ORIGIN=https://sim.example.com

# Frontend build-time env (origin yang sama dengan browser / cookie session)
VITE_API_BASE_URL=https://sim.example.com
