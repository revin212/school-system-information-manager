# Salin ke `.env.docker` di root repo dan sesuaikan nilai rahasia / domain.
# Jalankan dari root:
#   docker compose --profile full --env-file .env.docker up -d --build

# Alamat situs untuk Caddy:
# - Produksi: hostname (HTTPS otomatis), mis. sim.example.com
# - Full stack lokal: http://localhost
SITE_ADDRESS=sim.example.com

POSTGRES_USER=simsekolah
POSTGRES_PASSWORD=simsekolah
POSTGRES_DB=simsekolah

# Koneksi dari container API ke service compose `postgres`
DATABASE_URL=postgres://simsekolah:simsekolah@postgres:5432/simsekolah

BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
BETTER_AUTH_URL=https://sim.example.com
CORS_ORIGIN=https://sim.example.com
VITE_API_BASE_URL=https://sim.example.com

# --- Contoh full stack lokal: set SITE_ADDRESS=http://localhost dan samakan URL publik ---
# SITE_ADDRESS=http://localhost
# BETTER_AUTH_URL=http://localhost
# CORS_ORIGIN=http://localhost
# VITE_API_BASE_URL=http://localhost
