# Salin ke `.env.docker` di root repo dan sesuaikan nilai rahasia / domain.
# Jalankan dari root (Postgres lokal = profil local-db):
#   docker compose --profile full --profile local-db --env-file .env.docker up -d --build
# Deploy VPS dengan Postgres bersama: lihat deploy/README.md + docker-compose.prod.yml

POSTGRES_USER=simsekolah
POSTGRES_PASSWORD=simsekolah
POSTGRES_DB=simsekolah

# Koneksi dari container API ke service compose `postgres`
DATABASE_URL=postgres://simsekolah:simsekolah@postgres:5432/simsekolah

BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
BETTER_AUTH_URL=http://localhost
CORS_ORIGIN=http://localhost
VITE_API_BASE_URL=http://localhost:8000
